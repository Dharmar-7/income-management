// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USER
// Stores everyone who signs in to the app.
// Created automatically on first login via Clerk.
// ─────────────────────────────────────────
model User {
  id        String   @id @default(uuid())   // unique ID for each user
  clerkId   String   @unique                // the ID Clerk gives us after Google login
  email     String   @unique
  name      String?                         // optional — some Google accounts have no display name

  smsSyncedAt       DateTime? // last time we synced bank SMS (Android only)

  // Day the user's "money month" starts (1 = plain calendar month). Users paid
  // at month-end set e.g. 28 so reports align with their salary cycle.
  // Capped at 28 in the API so February always works.
  monthStartDay Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions          Transaction[]
  budgets               Budget[]
  cashTransactions      CashTransaction[]
  investmentPlatforms   InvestmentPlatform[]
  savings               Saving[]
  notes                 Note[]
  goals                 Goal[]
  netWorthSnapshots     NetWorthSnapshot[]
  recurringTransactions RecurringTransaction[]
  loans                 Loan[]
  settlements           Settlement[]
  documents             Document[]
  events                Event[]
  habits                Habit[]
  habitCheckins         HabitCheckin[]
  banks                 Bank[]
  pushTokens            PushToken[]
  jobSearches           SavedJobSearch[]
  watches               Watch[]

  // ── Notification preferences (server push) ──
  notifyJobs       Boolean  @default(true)   // push new job matches
  notifyNews       Boolean  @default(false)  // send the news digest
  newsCategories   String[] @default([])     // which desks: markets, tech, science…
  newsDigestAt     DateTime?                  // last news digest sent (dedup window)
  notifyBills      Boolean  @default(true)   // remind before bills/EMIs are due
  notifyBudgets    Boolean  @default(true)   // warn when a budget is nearly/over spent
  quietOvernight   Boolean  @default(false)  // suppress hourly pushes 10pm–7am IST
}

// ─────────────────────────────────────────
// PUSH TOKEN
// One Expo push token per device, so the server can push notifications
// (job matches, news digest) even when the app is closed.
// ─────────────────────────────────────────
model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique              // ExponentPushToken[...]
  platform  String?                       // 'ios' | 'android'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────
// SAVED JOB SEARCH
// A server-side copy of a device's saved search so the hourly cron can re-run
// it and push new matches even while the app is closed. Synced from the device;
// clientId is the on-device search id (so re-syncs upsert instead of duplicate).
// ─────────────────────────────────────────
model SavedJobSearch {
  id             String    @id @default(uuid())
  clientId       String                          // the on-device SavedSearch.id
  label          String
  what           String
  company        String?
  where          String?
  level          String?
  type           String?
  salaryMin      Int?
  seenJobIds     String[]                         // ids already notified/seen
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
}

// ─────────────────────────────────────────
// WATCH
// A "watch" is one company/topic term the user follows. The server checks it
// against BOTH new job postings (hourly) and fresh news (with the digest) and
// pushes matches — so a single term drives both alert channels. Synced from the
// device; clientId is the on-device id. Each watch keeps its own seen-sets.
// ─────────────────────────────────────────
model Watch {
  id             String    @id @default(uuid())
  clientId       String                          // the on-device Watch.id
  term           String                          // company or topic, e.g. "Google", "EV stocks"
  seenJobIds     String[]                         // job ids already notified
  seenNewsLinks  String[]                         // article links already notified
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
}

// ─────────────────────────────────────────
// NEWS SEEN
// Global dedup for the news digest: which article links we've already counted,
// so a story is never pushed twice. Pruned after a week. Not user-specific.
// ─────────────────────────────────────────
model NewsSeen {
  id     String   @id @default(uuid())
  link   String   @unique
  seenAt DateTime @default(now())

  @@index([seenAt])
}

// ─────────────────────────────────────────
// CATEGORY
// Labels used to group transactions.
// e.g. Food, Transport, Shopping, Bills
// ─────────────────────────────────────────
model Category {
  id    String @id @default(uuid())
  name  String @unique                      // e.g. "Food", "Transport"
  icon  String?                             // optional emoji or icon name

  // Relations
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
}

// ─────────────────────────────────────────
// TRANSACTION
// Every Google Pay transaction imported into the app.
// ─────────────────────────────────────────
model Transaction {
  id          String   @id @default(uuid())
  amount      Float                          // transaction amount in INR
  merchant    String                         // who was paid — e.g. "Swiggy", "Amazon"
  description String?                        // extra details from the transaction
  date        DateTime                       // when the transaction happened
  type        TransactionType                // DEBIT (money out) or CREDIT (money in)
  source      ImportSource                   // how it was imported
  upiRef      String?                        // UPI reference number for deduplication across sources

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  userId      String
  categoryId  String?                        // nullable — may not be categorized yet
  bankId      String?                        // which bank this came from (colour-coded)

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
  bank        Bank?     @relation(fields: [bankId], references: [id], onDelete: SetNull)

  // Prevent duplicate imports: same user, merchant, amount, and date = duplicate
  @@unique([userId, merchant, amount, date])
  // UPI ref deduplication — non-null values must be unique per user
  @@unique([userId, upiRef])

  // Performance indexes — these speed up the queries that run on every page load:
  // Summary, by-category, by-month all filter on userId + date + type
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
  @@index([userId, bankId, date])
}

// ─────────────────────────────────────────
// BANK
// A user's bank account, colour-coded so transactions can be grouped/scanned
// visually by which bank they came from (e.g. IOB = teal, TMB = orange).
// ─────────────────────────────────────────
model Bank {
  id        String   @id @default(uuid())
  name      String                          // e.g. "IOB", "TMB"
  color     String   @default("indigo")     // palette key — teal/indigo/orange/…
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
  @@index([userId])
}

// ─────────────────────────────────────────
// BUDGET
// Monthly spending limit a user sets per category.
// ─────────────────────────────────────────
model Budget {
  id         String @id @default(uuid())
  amount     Float                           // the spending limit in INR
  month      Int                             // 1–12
  year       Int                             // e.g. 2026
  lastAlertedPct Int  @default(0)            // highest spend-% already pushed this month (0/80/100)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Foreign keys
  userId     String
  categoryId String

  // Relations
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  // One budget per user per category per month
  @@unique([userId, categoryId, month, year])

  // Hot path: getBudgetsWithProgress filters on (userId, month, year) without
  // categoryId, so the @@unique prefix above can't serve it. This index does.
  @@index([userId, month, year])
}

// ─────────────────────────────────────────
// CASH TRANSACTION
// Tracks physical cash the user has in hand.
// Separate from digital bank/UPI transactions.
// ─────────────────────────────────────────
model CashTransaction {
  id        String     @id @default(uuid())
  amount    Float                           // amount in INR
  flow      CashFlow                        // IN (received) or OUT (spent/deposited)
  source    CashSource                      // where cash came from / went to
  note      String?                         // optional description
  date      DateTime                        // when it happened

  createdAt DateTime   @default(now())

  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─────────────────────────────────────────
// ENUMS
// Fixed set of allowed values for certain fields.
// ─────────────────────────────────────────
enum TransactionType {
  DEBIT      // money going out (you paid someone)
  CREDIT     // money coming in (someone paid you)
  REFUND     // partial/full refund — reduces expenses, not counted as income
  INVESTMENT // transfer to investment platform — excluded from all summary calculations
  TRANSFER   // peer-to-peer transfer (e.g. sent to friend, returned) — excluded from income/expense
}

enum ImportSource {
  TAKEOUT   // imported from Google Takeout JSON
  GMAIL     // synced from Gmail API
  MANUAL    // uploaded manually by the user
  SMS       // parsed from bank SMS (Android only)
  STATEMENT // parsed from an uploaded bank statement (PDF/photo)
}

enum CashFlow {
  IN   // cash received (ATM, person, other)
  OUT  // cash spent or deposited back to bank
}

enum CashSource {
  ATM        // withdrawn from ATM
  PERSON     // received from a person
  OTHER      // other cash in
  SPENT      // spent as cash payment
  DEPOSITED  // deposited back to bank
}

// ─────────────────────────────────────────
// INVESTMENT PLATFORM
// Tracks each investment app (Groww, Zerodha, etc.)
// Acts as a wallet — money added here gets reduced when investments are made.
// ─────────────────────────────────────────
model InvestmentPlatform {
  id          String   @id @default(uuid())
  name        String                         // e.g. "Groww", "Zerodha", "Post Office"
  totalAdded  Float    @default(0)           // total money transferred into this platform
  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  savings     Saving[]

  @@unique([userId, name])
  @@index([userId])
}

// ─────────────────────────────────────────
// SAVING
// An individual investment instrument.
// Linked to a platform (Groww SIP) or standalone (Post Office PPF).
// ─────────────────────────────────────────
model Saving {
  id             String      @id @default(uuid())
  name           String                          // e.g. "Nifty 50 SIP", "PPF"
  type           SavingType
  investedAmount Float                           // principal invested
  charges        Float       @default(0)         // brokerage, STT, GST etc.
  currentValue   Float                           // latest known value (updated manually)
  sipAmount      Float?                          // monthly SIP amount; enables the quick "+1 month" top-up button
  startDate      DateTime
  maturityDate   DateTime?                       // for FD, RD, NSC etc.
  note           String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  userId         String
  platformId     String?                         // null = standalone (no platform wallet)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       InvestmentPlatform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  contributions  SavingContribution[]

  @@index([userId])
  @@index([platformId])
}

// ─────────────────────────────────────────
// SAVING CONTRIBUTION
// One SIP top-up / contribution to a Saving. Lets each contribution map to the
// real bank transaction that funded it (which gets reclassified to INVESTMENT
// so it isn't also counted as an expense). Bare transactionId, looked up on
// read — same convention as Settlement / LoanPayment.
// ─────────────────────────────────────────
model SavingContribution {
  id            String   @id @default(uuid())
  amount        Float
  date          DateTime @default(now())
  transactionId String?  @unique

  createdAt DateTime @default(now())

  savingId String
  userId   String
  saving   Saving @relation(fields: [savingId], references: [id], onDelete: Cascade)

  @@index([savingId, date])
  @@index([userId])
}

enum SavingType {
  POST_OFFICE       // PPF, NSC, KVP, MIS, POTD
  FIXED_DEPOSIT     // Bank FDs
  RECURRING_DEPOSIT // Bank RDs
  STOCKS            // Direct equity (NSE/BSE)
  MUTUAL_FUNDS      // SIPs, lumpsum MFs
  GOLD              // Physical gold, SGB, Gold ETF
  EPF               // Employee Provident Fund
  NPS               // National Pension System
  OTHER
}

// ─────────────────────────────────────────
// NOTE
// A single note — title, markdown content,
// color, pin, archive, tags, optional reminder.
// ─────────────────────────────────────────
model Note {
  id           String      @id @default(uuid())
  title        String?                          // optional — some notes have no title
  content      String      @default("")         // markdown text (supports - [ ] checklists)
  color        String      @default("white")    // white/yellow/teal/pink/blue/purple/orange/green
  isPinned     Boolean     @default(false)
  isArchived   Boolean     @default(false)
  isLocked     Boolean     @default(false)      // password-protected note
  passwordHash String?                          // bcrypt hash — never exposed to client
  tags         String[]                         // e.g. ["finance", "ideas"]
  reminderAt   DateTime?                        // when to remind the user
  reminderSent Boolean     @default(false)      // cron marks true after firing

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       NoteImage[]

  @@index([userId, isArchived])
  @@index([userId, reminderAt, reminderSent])
}

// ─────────────────────────────────────────
// NOTE IMAGE
// Image attached to a note — stored as raw
// binary in the DB (no external service needed).
// ─────────────────────────────────────────
model NoteImage {
  id        String   @id @default(uuid())
  data      Bytes                              // raw binary image data
  mimeType  String                             // "image/jpeg", "image/png", etc.
  name      String                             // original filename
  size      Int                                // bytes — capped at 5 MB in the service

  createdAt DateTime @default(now())

  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// GOAL
// A savings goal — a target amount the user is
// working toward, with progress tracked manually.
// ─────────────────────────────────────────
model Goal {
  id           String    @id @default(uuid())
  name         String                             // e.g. "Emergency fund", "Goa trip"
  icon         String    @default("🎯")           // emoji shown on the goal card
  targetAmount Float                              // how much they want to reach
  savedAmount  Float     @default(0)              // progress so far (manual / via contribute)
  targetDate   DateTime?                          // optional "by when"
  note         String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────
// NET WORTH SNAPSHOT
// One stored data point per user per month, so a
// net-worth trend can build up over time (historical
// net worth can't be reconstructed, so we record it
// going forward).
// ─────────────────────────────────────────
model NetWorthSnapshot {
  id          String   @id @default(uuid())
  year        Int
  month       Int                                 // 1-12
  cash        Float                               // cash-in-hand balance at capture
  investments Float                               // total investment current value at capture
  netWorth    Float                               // cash + investments
  capturedAt  DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([userId])
}

// ─────────────────────────────────────────
// RECURRING TRANSACTION
// Bills, subscriptions and income that repeat
// on a fixed schedule (rent, Netflix, salary).
// ─────────────────────────────────────────
model RecurringTransaction {
  id          String             @id @default(uuid())
  name        String
  amount      Float
  type        TransactionType
  frequency   RecurringFrequency
  dayOfMonth  Int?               // for MONTHLY: 1–28
  dayOfWeek   Int?               // for WEEKLY: 0 (Sun)–6 (Sat)
  startDate   DateTime
  nextDueDate DateTime
  isActive    Boolean            @default(true)
  note        String?
  lastRemindedDue DateTime?      // nextDueDate we last pushed a reminder for (dedup)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  categoryId  String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([userId, nextDueDate])
  @@index([userId, isActive])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

// ─────────────────────────────────────────
// LOAN / EMI
// Tracks a loan — home, car, personal, etc.
// Each payment is stored in LoanPayment so
// outstanding balance can be computed exactly.
// ─────────────────────────────────────────
model Loan {
  id              String   @id @default(uuid())
  name            String
  loanType        LoanType
  lender          String
  principalAmount Float
  interestRate    Float    // annual % (e.g. 8.5 for 8.5%)
  tenure          Int      // total EMIs (months)
  emiAmount       Float    // monthly EMI in INR
  emiDay          Int      // day of month EMI is due (1–28)
  startDate       DateTime // disbursement / first EMI date
  isActive        Boolean  @default(true)
  note            String?
  lastRemindedEmi DateTime? // EMI due-date we last pushed a reminder for (dedup)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments LoanPayment[]

  @@index([userId, isActive])
}

model LoanPayment {
  id       String   @id @default(uuid())
  amount   Float
  paidDate DateTime

  // The real bank transaction this EMI payment maps to. When set, the app did
  // NOT create its own mirror transaction (avoids double-counting the expense).
  // Stored as a bare id (looked up on read) — same convention as Settlement.
  transactionId String? @unique
  // True when the app auto-created the transaction (cash / not-yet-imported),
  // vs linked an existing bank transaction. Governs cleanup on payment delete.
  txAutoCreated Boolean @default(false)

  createdAt DateTime @default(now())

  loanId String
  loan   Loan   @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, paidDate])
}

enum LoanType {
  HOME_LOAN
  CAR_LOAN
  PERSONAL_LOAN
  EDUCATION_LOAN
  TWO_WHEELER_LOAN
  CREDIT_CARD_EMI
  OTHER
}

// ─────────────────────────────────────────
// SETTLEMENT
// Tracks peer-to-peer money transfers — money sent
// to / received from a person that is expected to
// be returned. Both linked transactions get type=TRANSFER
// so they are excluded from income/expense calculations.
// ─────────────────────────────────────────
model Settlement {
  id          String           @id @default(uuid())
  personName  String
  amount      Float
  direction   String           // 'SENT' (you paid them) or 'RECEIVED' (they paid you)
  status      SettlementStatus @default(PENDING)
  note        String?
  transferredAt DateTime       // when the initial transfer happened
  settledAt     DateTime?      // when it was repaid/settled

  // Legacy 1:1 links — kept for older settlements. New settlements group any
  // number of transactions via SettlementEntry (many sends ↔ many returns),
  // and leave these null. When set (legacy), the linked tx type is TRANSFER.
  originalTxId  String? @unique  // the initial transfer transaction
  repaymentTxId String? @unique  // the repayment transaction

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries SettlementEntry[]

  @@index([userId, status])
  @@index([userId, personName])
}

// One transaction attached to a settlement "tab". A settlement can hold many:
// several PRINCIPAL legs (the money that moved out/in) and several REPAYMENT
// legs (the money coming back) — in any combination. Each linked transaction is
// re-typed TRANSFER so it's excluded from income/expense. Balance = Σprincipal
// − Σrepayment; the settlement is SETTLED when that reaches zero.
model SettlementEntry {
  id            String        @id @default(uuid())
  kind          SettlementLeg
  amount        Float
  occurredAt    DateTime
  // The real transaction this leg maps to (re-typed TRANSFER). Null = a manual
  // amount with no bank transaction (e.g. cash returned).
  transactionId String?       @unique
  note          String?

  createdAt DateTime @default(now())

  settlementId String
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

enum SettlementLeg {
  PRINCIPAL  // money that moved in the settlement's direction (what needs settling)
  REPAYMENT  // money settling it back
}

enum SettlementStatus {
  PENDING    // waiting for repayment
  SETTLED    // repayment received/made
  CANCELLED  // manually cancelled — no repayment expected
}

// ─────────────────────────────────────────
// DOCUMENT
// A stored important document — insurance, ID,
// vehicle papers, warranty, receipt. Binary held
// in the DB (same approach as note images).
// ─────────────────────────────────────────
model Document {
  id        String    @id @default(uuid())
  name      String                             // user-given name
  category  String    @default("Other")        // Insurance, ID, Vehicle, Warranty, Receipt, Other
  data      Bytes                              // raw binary (image/pdf)
  mimeType  String                             // "image/jpeg", "application/pdf", …
  size      Int                                // bytes — capped in the service
  note      String?
  expiresAt DateTime?                          // optional renewal/expiry date

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
}

// ─────────────────────────────────────────
// EVENT
// A memorable occasion (birthday, anniversary)
// that recurs yearly. `isSelf` events trigger an
// app-open celebration; others just notify/remind.
// ─────────────────────────────────────────
model Event {
  id               String    @id @default(uuid())
  title            String                          // "My Birthday", "Brother's Birthday"
  type             EventType @default(BIRTHDAY)
  date             DateTime                         // original date — month/day drive the yearly recurrence
  isSelf           Boolean   @default(false)        // about the user → confetti on app open
  personName       String?                          // whose occasion ("Brother", "Mom")
  notifyDaysBefore Int       @default(0)            // remind N days before (0 = on the day)
  note             String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EventType {
  BIRTHDAY
  ANNIVERSARY
  MEMORIAL
  FESTIVAL
  CUSTOM
}

// ─────────────────────────────────────────
// HABIT
// A daily habit the user wants to build (Workout,
// Reading, AI Learning…). Progress is tracked via
// HabitCheckin rows — one per day the habit is ticked.
// ─────────────────────────────────────────
model Habit {
  id         String   @id @default(uuid())
  name       String                            // e.g. "Workout", "AI Learning"
  icon       String   @default("✅")            // emoji shown on the row
  color      String   @default("indigo")        // accent key — indigo/green/orange/teal/violet/danger
  weeklyTarget Int    @default(7)              // how many days/week is "success" (1–7)
  scheduleDays Int[]  @default([0,1,2,3,4,5,6]) // 0=Sun … 6=Sat — which days this habit is planned
  order      Int      @default(0)              // manual sort order on the board
  isArchived Boolean  @default(false)
  note       String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkins   HabitCheckin[]

  @@index([userId, isArchived])
}

// ─────────────────────────────────────────
// HABIT CHECK-IN
// One row per (habit, day) the user marked. Absence of
// a row = not done. status distinguishes a full tick (✅)
// from a partial one (🟡), mirroring the Life OS board.
// ─────────────────────────────────────────
model HabitCheckin {
  id      String      @id @default(uuid())
  day     String                              // calendar day "YYYY-MM-DD" (local day, kept as string for stable streaks)
  status  HabitStatus @default(DONE)

  createdAt DateTime  @default(now())

  habitId String
  userId  String                              // denormalised for cheap per-user date scans (powers streaks)

  habit   Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One check-in per habit per day.
  @@unique([habitId, day])
  @@index([userId, day])
}

enum HabitStatus {
  DONE     // ✅ full completion (counts 1.0)
  PARTIAL  // 🟡 partial completion (counts 0.5)
}
